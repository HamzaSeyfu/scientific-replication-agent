# Token Factory inference. Never commit the real value.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ConTree runtime uses its saved auth profile. These values select a profile/image.
CONTREE_PROFILE=default
CONTREE_IMAGE=docker://docker.io/python:3.11
